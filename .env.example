# =============================================================================
# ReachAI — environment configuration
# Copy to `.env` at the repo root. Never commit real secrets.
# Every provider below is optional: when credentials are missing the app either
# falls back to a clearly-labelled mock provider (DEMO_MODE=true) or shows a
# "Connect provider" state. Nothing pretends to work without credentials.
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
# development | staging | production
APP_ENV=development
APP_URL=http://localhost:3000
# When true, missing providers fall back to mock adapters and the UI shows a
# persistent "Demo mode" indicator. Must be false in production.
DEMO_MODE=true
# Simulate inbound provider events (deliveries, opens, replies, call outcomes)
# for mock providers so the full loop can be demonstrated. Only used when DEMO_MODE=true.
DEMO_SIMULATE_EVENTS=true
LOG_LEVEL=debug

# ---- Database (PostgreSQL) -----------------------------------------------------
DATABASE_URL=postgresql://reachai:reachai@localhost:54329/reachai?schema=public
# Direct (non-pooled) connection used by migrations. Same as DATABASE_URL locally.
DIRECT_URL=postgresql://reachai:reachai@localhost:54329/reachai?schema=public
# Used by integration tests (created by infra/docker/postgres/init.sql).
TEST_DATABASE_URL=postgresql://reachai:reachai@localhost:54329/reachai_test?schema=public

# ---- Redis (queues, rate limits, caching) --------------------------------------
REDIS_URL=redis://localhost:6379
# bullmq = Redis-backed queues processed by apps/worker (production).
# inline = jobs run inside the web process with the same retry/backoff policy — for local
#          development on machines without Redis. Never use inline in production.
QUEUE_DRIVER=bullmq

# ---- Security ------------------------------------------------------------------
# 32+ char random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Key used to encrypt provider credentials at rest (AES-256-GCM). 32 bytes, base64.
ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Signs unsubscribe links and internal callback tokens.
SIGNING_SECRET=replace-with-another-long-random-string

# ---- Authentication ------------------------------------------------------------
AUTH_REQUIRE_EMAIL_VERIFICATION=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI providers --------------------------------------------------------------
# mock | openai | anthropic | google
AI_DEFAULT_PROVIDER=mock
# Optional overrides; defaults are defined in packages/config/src/ai-models.ts
AI_DEFAULT_MODEL=
AI_FALLBACK_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Cache identical AI requests (seconds). 0 disables.
AI_CACHE_TTL_SECONDS=86400

# ---- Lead data providers -------------------------------------------------------
# mock | google_places
LEAD_PROVIDER=mock
GOOGLE_PLACES_API_KEY=
# Public website enrichment (fetches homepage only, honours robots.txt)
ENRICHMENT_WEBSITE_FETCH_ENABLED=false

# ---- Email ---------------------------------------------------------------------
# mock | resend | sendgrid | smtp
EMAIL_PROVIDER=mock
EMAIL_FROM="ReachAI <outreach@example.com>"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---- WhatsApp (official Meta WhatsApp Business Cloud API only) -----------------
# mock | meta
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v21.0

# ---- Voice ---------------------------------------------------------------------
# mock | twilio | vapi — see docs/calling.md. Webhooks need a public APP_URL.
VOICE_PROVIDER=mock
# Twilio: places the call; the conversation runs turn by turn via /api/webhooks/voice/twilio/turn
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Vapi: hosted voice agent; server URL /api/webhooks/voice/vapi, secret sent as x-vapi-secret
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# ---- Billing (Stripe) ----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_SCALE_MONTHLY=

# ---- n8n -----------------------------------------------------------------------
# Set to http://localhost:5678 after `npm run infra:up` (empty = n8n steps are simulated in demo mode).
N8N_URL=
# n8n → Settings → n8n API; lets ReachAI list your workflows.
N8N_API_KEY=
# Signs ReachAI → n8n calls (x-reachai-signature); set the same value as REACHAI_WEBHOOK_SECRET in n8n.
N8N_WEBHOOK_SECRET=replace-with-a-shared-secret

# ---- Storage (S3-compatible) ---------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reachai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ---- Notifications -------------------------------------------------------------
SLACK_WEBHOOK_URL=
