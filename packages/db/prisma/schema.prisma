// =============================================================================
// ReachAI — PostgreSQL schema
//
// Conventions
//  - UUID primary keys everywhere.
//  - Every tenant-owned table carries `organizationId` and is indexed by it first.
//    Tenant scoping is enforced in packages/db/src/tenant.ts.
//  - `deletedAt` = soft delete for user-facing records that others reference.
//  - `Event` is the immutable, append-only log that powers timelines and analytics.
//  - Money: Decimal(14,2) in the organisation currency. AI cost: integer micro-USD.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

