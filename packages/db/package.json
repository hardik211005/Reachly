{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tenant": "./src/tenant.ts",
    "./enums": "./src/generated/prisma/enums.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run seed -w @repo/core",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@repo/config": "*",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@repo/tsconfig": "*",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
